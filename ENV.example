# Example environment variables for local development
# Copy to .env and fill values as needed. Do NOT commit secrets.

# Server
PORT=3000

# Database (dev): sqlite example
# For Postgres (production) use a full URL: postgres://user:pass@host:5432/db
DATABASE_URL=sqlite:./data/convergd.sqlite

# AI provider (hf | openai | local)
AI_PROVIDER=hf
AI_ENABLED=false
HF_API_KEY=
OPENAI_API_KEY=

# Redis for cross-node pub/sub (optional)
REDIS_URL=redis://localhost:6379

# Prometheus
PROMETHEUS_ENABLED=true

# Other
LOG_LEVEL=info
